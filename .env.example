# Copie este arquivo para .env, que fica fora do controle de versão.
# A aplicação lê estas configurações ao rodar na sua máquina (uv run ...).
# No Docker, o docker-compose.yml define esses valores.

# PostgreSQL do Docker Compose (porta 5433 no computador). Sem esta variável, os dados ficam em memória.
DATABASE_URL=postgresql://manutencao:manutencao@localhost:5433/manutencao

# O e-mail (RF08) vai para o Mailpit do Docker Compose. Caixa de entrada em http://localhost:8025.
# Sem SMTP_HOST, o envio de e-mails é simulado.
SMTP_HOST=localhost
SMTP_PORTA=1025
SMTP_REMETENTE=manutencao@example.com
# Um provedor como o Gmail também precisa de usuário e senha de aplicativo.
# SMTP_USUARIO=voce@gmail.com
# SMTP_SENHA=sua-senha-de-aplicativo
