# Copy this file to .env and adjust it. The .env file is not committed.
# Without DATABASE_URL, the app stores data in memory.
# Local PostgreSQL through the Unix socket (role = your Linux user):
DATABASE_URL=postgresql:///manutencao
# With a password instead:
# DATABASE_URL=postgresql://user:password@localhost:5432/manutencao

# E-mail (RF08). Without SMTP_HOST, e-mails go to a fake that sends nothing.
# Local Mailpit: SMTP on port 1025, inbox at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORTA=1025
SMTP_REMETENTE=manutencao@example.com
# A real provider (e.g. Gmail with an app password) also needs:
# SMTP_USUARIO=you@gmail.com
# SMTP_SENHA=your-app-password
