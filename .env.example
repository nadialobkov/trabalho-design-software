# Copy this file to .env. The .env file is not committed.
# Used when the app runs on your machine (uv run ...). Inside Docker,
# docker-compose.yml sets these values itself.

# PostgreSQL from docker compose (host port 5433). Without it, data stays in memory.
DATABASE_URL=postgresql://manutencao:manutencao@localhost:5433/manutencao

# E-mail (RF08) to Mailpit from docker compose; inbox at http://localhost:8025.
# Without SMTP_HOST, e-mails go to a fake that sends nothing.
SMTP_HOST=localhost
SMTP_PORTA=1025
SMTP_REMETENTE=manutencao@example.com
# A real provider (e.g. Gmail with an app password) also needs:
# SMTP_USUARIO=you@gmail.com
# SMTP_SENHA=your-app-password
